        "subject_prefix": "[MEOP]"
      }
    },
    "references": {
      "cora_dir": "",
      "reference_dataset_dir": ""
    }
  },
  "configs": {
    "workstation": {
      "processdir": ".",
      "datadir": "data",
      "public": "public",
      "batch": { "jobs": 8 }
    },
    "laptop": {
      "processdir": ".",
      "datadir": "data",
      "public": "public",
      "batch": { "jobs": 2 }
    }
  }
