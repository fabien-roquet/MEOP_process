{
  "defaults": {
    "machine": "workstation",
    "version": "",
    "diagnostics": {
      "qf": "lr1",
      "adjusted": true,
      "parts": ["tag", "deployment", "overview"]
    },
    "batch": {
      "jobs": 4,
      "verbose": false,
      "diagnostics": true
    },
    "publish": {
      "enabled": true,
      "build_maps": true,
      "build_plots": false,
